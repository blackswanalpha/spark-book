{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "sparkBook",
  "version": "0.11.0",
  "identifier": "com.sparkbook.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "sparkBook",
        "width": 1280,
        "height": 800,
        "minWidth": 720,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "sparkBook team",
    "category": "DeveloperTool",
    "shortDescription": "One window. Text, images, animation and PDFs.",
    "longDescription": "sparkBook \u2014 markdown, rich text, code, images, animation and PDFs in one window. File is source of truth.",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": []
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    },
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      },
      "wix": {
        "language": "en-US"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc0REYxQkZFQjA2NzUxNUEKUldSYVVXZXcvaHZmZEtreWRqUzdDaUF0S0xmR2tvOUo5TU5XZTY3SVVxZ244Um9iZVhIR1BXMG4K",
      "endpoints": [
        "https://github.com/blackswanalpha/spark-book/releases/latest/download/latest.json"
      ]
    }
  }
}
